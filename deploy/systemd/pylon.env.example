# /etc/pylon/pylon.env — copy this file to /etc/pylon/pylon.env and edit.
# Owned by root:pylon, mode 0640 (the pylon user reads it; others cannot).
#   install -m 0640 -o root -g pylon pylon.env.example /etc/pylon/pylon.env
#
# Every variable below is verified against src/server/config.rs — defaults
# shown are the parser's defaults.

# ── Core ─────────────────────────────────────────────────────────────────────

# IP address to bind.  0.0.0.0 = all interfaces.
PYLON_BIND=0.0.0.0

# TCP port for the WebSocket listener and HTTP REST API.
PYLON_PORT=7000

# Path to the apps.json file (used when PYLON_APP_MANAGER=static).  See
# apps.example.json for the JSON format (id/key/secret, per-app "capacity",
# webhooks, …).
PYLON_APPS_PATH=/etc/pylon/apps.json

# Number of per-core I/O worker threads (each a pinned OS thread running its
# own mio event loop).  0 = auto (one per logical CPU).
PYLON_WORKERS=0

# Log output format: "text" (human-readable) or "json" (one JSON object per
# line). Any other value is a startup error reported on stderr, since no
# subscriber exists yet to receive it.
#PYLON_LOG_FORMAT=text

# ── Application store ────────────────────────────────────────────────────────

# Application store backend: static (apps.json file), sqlite, mysql,
# postgres, or mongo. A non-static backend also needs PYLON_APP_DSN.
#PYLON_APP_MANAGER=static

# Database connection string for a non-static PYLON_APP_MANAGER, e.g.
# postgres://user:pass@host/db. Unset by default (no DB-backed store).
#PYLON_APP_DSN=postgres://user:pass@host/db

# Enable the cache in front of a DB-backed store. 0/off/false disables it
# (every lookup hits the database). No effect for the static manager.
#PYLON_APP_CACHE=true

# L1 (in-process) cache max capacity, in number of apps. Bounded so
# "unlimited apps" never grows memory without bound.
#PYLON_APP_CACHE_MAX=100000

# L1 positive-entry TTL in seconds — the worst-case staleness floor even
# if no invalidation signal ever arrives.
#PYLON_APP_CACHE_TTL=300

# L1 negative-cache (unknown-key) max capacity — kept separate so a flood
# of bad keys never evicts real apps.
#PYLON_APP_CACHE_NEG_MAX=10000

# L1 negative-entry TTL in seconds. Kept short.
#PYLON_APP_CACHE_NEG_TTL=30

# Optional Redis URL for the shared L2 cache + cross-node invalidation
# channel. Unset by default (L1-only, no invalidation API).
#PYLON_APP_CACHE_REDIS_URL=redis://127.0.0.1:6379

# Bearer token for the admin API (POST /admin/apps/{id}/invalidate).
# Unset by default, which disables the admin API entirely (404).
#PYLON_ADMIN_TOKEN=change-me-admin-token

# Bearer token for GET /metrics. Unset by default (metrics open); when
# set, a mismatched scrape gets 404, not 401. /health and /ready are
# never gated.
#PYLON_METRICS_TOKEN=change-me-metrics-token

# Interval in seconds for the app-purge sweep backstop that force-closes
# connections for apps removed/disabled in the database. 0 disables it.
#PYLON_APP_SWEEP_INTERVAL=0

# Seconds between app-store health probes (exported as
# pylon_app_store_up). Minimum 1; 0 fails startup.
#PYLON_APP_STORE_PROBE_INTERVAL_SECS=15

# Milliseconds a single app-store probe may take before it's recorded as
# down. Minimum 1; 0 fails startup.
#PYLON_APP_STORE_PROBE_TIMEOUT_MS=2000

# ── Adapter / Redis ──────────────────────────────────────────────────────────

# "local" (single-node, no Redis) or "redis" (cluster mode).
PYLON_ADAPTER=local

# Required when PYLON_ADAPTER=redis.
#PYLON_REDIS_URL=redis://127.0.0.1:6379

# Key prefix applied to all Redis keys, to avoid collisions with other
# services sharing the same Redis instance.
#PYLON_REDIS_PREFIX=pylon

# Size of the Redis connection pool per server instance.
#PYLON_REDIS_POOL_SIZE=6

# Seconds after which a cluster node's membership entry expires if not
# renewed.
#PYLON_REDIS_MEMBERSHIP_TTL=60

# Interval in seconds at which presence member entries are refreshed in
# Redis.
#PYLON_REDIS_PRESENCE_HEARTBEAT=25

# Interval in seconds at which each node publishes its heartbeat to Redis.
#PYLON_REDIS_NODE_HEARTBEAT=5

# Interval in seconds at which stale presence and membership entries are
# swept.
#PYLON_REDIS_SWEEP_INTERVAL=10

# Enable Redis 7+ sharded Pub/Sub. Set 1/true to enable.
#PYLON_REDIS_SHARDED_PUBSUB=false

# Emit the Redis cluster relay envelope in its compat (double-carry)
# shape, so mixed-version fleets relay in both directions during rolling
# upgrades. Set 0/false/off only once EVERY node ships this knob.
#PYLON_CLUSTER_ENVELOPE_COMPAT=true

# ── TLS (optional) ───────────────────────────────────────────────────────────

# PEM certificate chain and PEM private key (PKCS#8, RSA, or EC).  Both must
# be set together to enable TLS on the WebSocket/HTTP listener; setting only
# one is a fatal config error.  Leave both unset for plain HTTP/WebSocket.
#PYLON_TLS_CERT=/etc/pylon/tls/fullchain.pem
#PYLON_TLS_KEY=/etc/pylon/tls/privkey.pem

# Optional PEM CA certificate for mutual TLS client verification. Requires
# PYLON_TLS_CERT and PYLON_TLS_KEY to also be set.
#PYLON_TLS_CA=/etc/pylon/tls/clients-ca.pem

# ── Protocol / Limits ────────────────────────────────────────────────────────

# Seconds of inactivity after which the server sends a pusher:ping.
#PYLON_ACTIVITY_TIMEOUT=120

# Seconds the server waits for a pusher:pong reply before closing the
# connection.
#PYLON_PONG_TIMEOUT=30

# Maximum connection age in seconds before the server closes with code
# 4202 (clients reconnect immediately). Absolute from connection
# establishment, not reset by activity. 0 disables it.
#PYLON_MAX_CONN_LIFETIME_SECS=86400

# Maximum accepted HTTP request-head size in bytes before the handshake
# completes — slowloris protection. 0 disables it.
#PYLON_MAX_HEAD_BYTES=16384

# Milliseconds from TCP accept within which a connection must complete
# its handshake — slowloris protection, absolute from accept. 0 disables
# it.
#PYLON_HANDSHAKE_TIMEOUT_MS=10000

# Reject any Pusher protocol violation instead of silently ignoring it.
# Set 1/true to enable.
#PYLON_STRICT_PROTOCOL=false

# Maximum channel name length in bytes. Matches both actively-maintained
# official server SDKs (200); set 164 to match the published Pusher doc
# literally instead.
#PYLON_MAX_CHANNEL_NAME_LENGTH=200

# Maximum event name length in bytes.
#PYLON_MAX_EVENT_NAME_LENGTH=200

# Maximum event payload size in bytes (hosted Pusher: "smaller than
# 10kB", decimal — not 10240/10 KiB).
#PYLON_MAX_EVENT_PAYLOAD_BYTES=10000

# Maximum number of members allowed in a presence channel.
#PYLON_MAX_PRESENCE_MEMBERS=100

# Maximum length of a presence member's user_id in bytes.
#PYLON_MAX_PRESENCE_USER_ID_LENGTH=128

# Maximum size of a presence member's user_info JSON in bytes.
#PYLON_MAX_PRESENCE_USER_INFO_BYTES=1024

# Maximum client events a single connection may send per second.
#PYLON_MAX_CLIENT_EVENTS_PER_SECOND=10

# Sustained inbound WebSocket frame rate a single connection may send,
# counting every frame kind. Over the limit closes with code 4100. 0
# disables it.
#PYLON_MAX_FRAMES_PER_SECOND=100

# Burst allowance for PYLON_MAX_FRAMES_PER_SECOND. DERIVED by default from
# PYLON_MAX_SUBSCRIPTIONS_PER_CONNECTION (not a fixed number — see
# configuration.md); an explicit value below the subscription cap refuses to start.
#PYLON_MAX_FRAMES_BURST=250

# Maximum simultaneous channel subscriptions per connection. Excess
# subscribes get a non-fatal pusher:subscription_error (4004). 0 =
# unlimited.
#PYLON_MAX_SUBSCRIPTIONS_PER_CONNECTION=200

# Maximum number of channels a single connection may watch simultaneously.
#PYLON_MAX_WATCHLIST_SIZE=100

# TTL in seconds for cached channel and presence state.
#PYLON_CACHE_TTL_SECS=1800

# Maximum number of channels a single REST publish call may target.
#PYLON_MAX_CHANNELS_PER_PUBLISH=100

# Maximum number of events in a single batch publish request.
#PYLON_MAX_BATCH_EVENTS=10

# Acceptable clock-skew window in seconds for REST request timestamp
# validation.
#PYLON_REST_AUTH_WINDOW_SECS=600

# ── Webhooks ─────────────────────────────────────────────────────────────────

# Webhook targets are configured PER-APP in apps.json ("webhooks" array) —
# there is no server-wide webhook URL variable.

# Time window in milliseconds over which outgoing webhook events are
# batched.
#PYLON_WEBHOOK_BATCH_MS=50

# Maximum number of concurrent in-flight webhook deliveries.
#PYLON_WEBHOOK_MAX_CONCURRENCY=100

# First retry delay in milliseconds after a failed delivery; doubles each
# attempt, capped by PYLON_WEBHOOK_BACKOFF_CAP_MS.
#PYLON_WEBHOOK_BACKOFF_BASE_MS=1000

# Upper bound in milliseconds for each webhook retry delay.
#PYLON_WEBHOOK_BACKOFF_CAP_MS=60000

# Total time (attempts + backoffs), in milliseconds, a delivery keeps
# retrying without a 2xx — Pusher parity ("exponential backoff, for 5
# minutes"). 0 disables retries.
#PYLON_WEBHOOK_RETRY_BUDGET_MS=300000

# Per-attempt HTTP request timeout in milliseconds.
#PYLON_WEBHOOK_TIMEOUT_MS=5000

# SSRF guard escape hatch: set 1/true to allow webhook delivery to
# private/loopback/link-local targets. Refused targets fail fast.
#PYLON_WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Reconnect grace period in milliseconds before a channel_vacated /
# member_removed webhook fires; suppressed if re-occupied/re-joined
# within the window. 0 fires immediately.
#PYLON_WEBHOOK_VACATED_GRACE_MS=3000

# ── Overload / Capacity ──────────────────────────────────────────────────────

# All defaults below are auto-derived from the host's memory envelope and
# CPU count. Override only when you need to tune for a specific workload.

# Total transport memory budget in bytes. Sizes each worker's outbound
# queue budget and the shedding bands — it is NOT a hard RSS cap. 0 = auto
# (derived from cgroup/host memory, capped at 50% of the envelope).
#PYLON_MEMORY_BUDGET_BYTES=0

# Memory budget as a fraction of effective host memory (0.0-1.0), applied
# only when PYLON_MEMORY_BUDGET_BYTES is 0. 0.0 = use the reserve formula
# above instead.
#PYLON_MEMORY_BUDGET_FRACTION=0.0

# Explicit node-wide connection ceiling across all apps (0 = auto-derive from
# the memory budget; connections beyond it are closed with 4100).
#PYLON_MAX_CONNECTIONS=0

# Expected per-connection memory footprint in bytes, used to auto-derive
# PYLON_MAX_CONNECTIONS from the budget (default 8192).
#PYLON_EXPECTED_PER_CONN_BYTES=8192

# Capacity in frames of each connection's inbound mailbox (presence
# rosters, member_added/removed, user-targeted events, cluster
# deliveries). A full mailbox silently drops the frame. Must be > 0.
#PYLON_MAILBOX_CAPACITY=256

# Expected concurrent connections per worker thread, used to derive the
# per-connection outbound queue cap.
#PYLON_EXPECTED_CONNS_PER_WORKER=50000

# Lower clamp for the per-connection outbound queue cap, in bytes.
#PYLON_PERCONN_QUEUE_MIN_BYTES=262144

# Upper clamp for the per-connection outbound queue cap, in bytes.
#PYLON_PERCONN_QUEUE_MAX_BYTES=8388608

# Active queue management (CoDel) target queue delay in milliseconds.
#PYLON_CODEL_TARGET_MS=5

# CoDel interval in milliseconds.
#PYLON_CODEL_INTERVAL_MS=100

# PSI (Pressure Stall Information) memory-pressure threshold in PERCENT of
# `full avg10` above which the per-worker budget factor shrinks toward its
# 0.8 floor (polled once a second).
#PYLON_PSI_THRESHOLD=15.0

# PSI backstop: auto-enabled when the kernel pressure file is readable.
# There is NO "auto" value -- auto IS the unset state, so leave this
# commented out to get it. Set 1/true to force on, 0/false to force off.
#PYLON_PSI_BACKSTOP=1

# Capacity in frames of each worker's bounded broadcast hand-off channel.
#PYLON_BROADCAST_HANDOFF_CAP=1024

# Node-wide cap on newly accepted TCP connections per second, divided
# evenly across workers. Counts every accepted socket. 0 = unlimited.
#PYLON_MAX_ACCEPTS_PER_SECOND=0

# Node-wide cap on REST API requests per second, applied before
# authentication. Over the cap: 429 with Retry-After. 0 = unlimited.
#PYLON_MAX_REST_REQUESTS_PER_SECOND=0

# Default per-app cap on published events per second. A non-zero value
# below PYLON_MAX_BATCH_EVENTS is refused at startup. 0 = unlimited.
#PYLON_MAX_BACKEND_EVENTS_PER_SECOND=0

# Default per-app cap on REST read requests per second. 0 = unlimited.
#PYLON_MAX_READ_REQUESTS_PER_SECOND=0

# ── Graceful shutdown ────────────────────────────────────────────────────────

# Milliseconds to wait after SIGTERM before beginning the connection drain.
# During this window /ready returns 503, letting load balancers stop sending
# new connections before existing ones are closed.
PYLON_SHUTDOWN_PREDRAIN_MS=2000

# Maximum milliseconds to wait for in-flight connections to flush before
# forcing process exit.
PYLON_SHUTDOWN_GRACE_MS=10000
