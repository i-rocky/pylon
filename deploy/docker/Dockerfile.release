# syntax=docker/dockerfile:1
#
# deploy/docker/Dockerfile.release — packages a PREBUILT static musl pylon
# binary into a scratch image. Used by .github/workflows/release.yml, which
# builds native musl binaries per-arch and stages them under dist/<arch>/pylon,
# then runs a single multi-platform `buildx` build (so no compilation happens
# here).
#
# For a from-source image instead, use deploy/docker/Dockerfile.
#
# Health probes: probe over HTTP from OUTSIDE the container — a scratch image
# carries no shell, curl or wget.
#   Liveness:   GET /health  → 200 "ok"
#   Readiness:  GET /ready   → 200 "ready" / 503 "draining"

FROM --platform=$BUILDPLATFORM debian:trixie-20260824-slim AS certs
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

FROM scratch

COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY deploy/docker/passwd.nobody /etc/passwd

# TARGETARCH is set by buildx per target platform (amd64 | arm64); the release
# workflow stages the matching native binary at dist/<arch>/pylon.
ARG TARGETARCH
COPY dist/${TARGETARCH}/pylon /usr/local/bin/pylon
COPY apps.example.json /etc/pylon/apps.example.json

EXPOSE 7000

USER 65534:65534

ENTRYPOINT ["/usr/local/bin/pylon"]
